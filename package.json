{
  "name": "dasems",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @dasems/api\" \"npm run dev -w @dasems/web\" \"npm run dev:processor\"",
    "dev:api": "npm run dev -w @dasems/api",
    "dev:web": "npm run dev -w @dasems/web",
    "dev:processor": "cd services/processor && python3 -m uvicorn main:app --reload --port 5001",
    "build": "npm run build -w @dasems/shared-types && npm run build -w @dasems/api && npm run build -w @dasems/web",
    "seed": "npm run seed -w @dasems/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.1",
    "babel-preset-expo": "^57.0.1",
    "sharp": "^0.35.2"
  }
}
